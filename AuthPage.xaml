<Page x:Class="Кудрявцева41размер.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Кудрявцева41размер"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Логин" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10" FontSize="16"/>
        <TextBox Name="LoginTB" Grid.Row="0" Grid.Column="1" Width="200" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10"/>

        <TextBlock Text="Пароль" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10" FontSize="16"/>
        <TextBox Name="PassTB" Grid.Row="1" Grid.Column="1" Width="200" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10"/>

        <Canvas Name="CaptchaPanel" Grid.Row="2" Grid.Column="1" Width="140" Height="50" Visibility="Collapsed" Margin="10,10,0,5" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock Name="CaptchaOneWord" FontSize="24" Canvas.Left="0" Canvas.Top="15"/>
            <TextBlock Name="CaptchaTwoWord" FontSize="24" Canvas.Left="30" Canvas.Top="0" TextDecorations="Strikethrough"/>
            <TextBlock Name="CaptchaThreeWord" FontSize="24" Canvas.Left="60" Canvas.Top="20"/>
            <TextBlock Name="CaptchaFourWord" FontSize="24" Canvas.Left="90" Canvas.Top="5" TextDecorations="Strikethrough"/>
        </Canvas>

        <TextBox Name="CaptchaTB" Grid.Row="3" Grid.Column="1" Width="200" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,5,10,10" Visibility="Collapsed"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Войти как гость" Name="GuestBtn" Click="Guest_Click" Width="200" Margin="10"/>
            <Button Name="LoginBtn" Content="Войти" Click="LoginBtn_Click" Width="200" Margin="10"/>
        </StackPanel>
    </Grid>
</Page>