<Page x:Class="Кудрявцева41размер.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Кудрявцева41размер"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage"
      DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
            
            <TextBlock Name="FIOTB" FontSize="14" HorizontalAlignment="Right"/>
            <TextBlock Name="RoleTB" FontSize="14" HorizontalAlignment="Right"/>
            <Button Content="Назад" Click="GoBack_Click" Margin="0,5,0,0" HorizontalAlignment="Right" Width="100" Height="30"/>
        </StackPanel>
        <TextBlock Grid.Row="0" Margin="10">
    <Run Text="Количество: "/>
    <Run Text="{Binding ElementName=ProductListView, Path=Items.Count, Mode=OneWay}" FontWeight="Bold"/>
    <Run Text=" из "/>
    <Run Text="{Binding TotalCount}" FontWeight="Bold"/>
        </TextBlock>

        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,10">
            <TextBlock Text="Поиск:" VerticalAlignment="Center"/>
            <TextBox Name="TBoxSearch" Width="150" TextChanged="TBoxSearch_TextChanged" Margin="5,0,15,0"/>

            <TextBlock Text="Сортировка:" VerticalAlignment="Center"/>
            <RadioButton Name="RadioAsc" Content="По возрастанию стоимости" GroupName="Sort" Checked="Sort_Checked" Margin="5,0,10,0"/>
            <RadioButton Name="RadioDesc" Content="По убыванию стоимости" GroupName="Sort" Checked="Sort_Checked" Margin="0,0,15,0"/>

            <TextBlock Text="Скидка: " VerticalAlignment="Center"/>
            <ComboBox Name="ComboDiscount" SelectionChanged="ComboDiscount_SelectionChanged" Width="150">
                <ComboBoxItem Content="Все" IsSelected="True"/>
                <ComboBoxItem Content="0-9,99%"/>
                <ComboBoxItem Content="10-14,99%"/>
                <ComboBoxItem Content="15% и более"/>
            </ComboBox>
        </WrapPanel>

        <ListView Grid.Row="2" Name="ProductListView" Margin="10,0">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <Image Width="130" Height="130" Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Left">
                            <Image.Source>
                                <Binding Path="ProductPhotoFull">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            Resources/picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>

                        <StackPanel Grid.Column="1" Margin="20,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProductName}" FontSize="18" TextWrapping="Wrap" Margin="0, 0, 0, 20" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ProductDescription}" FontSize="19" TextWrapping="Wrap" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding ProductManufacturer}" FontSize="18" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding ProductCost, StringFormat={}{0:0} рублей}" FontSize="14"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="Скидка" FontSize="22" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding ProductDiscountAmount, StringFormat={}{0} %}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
