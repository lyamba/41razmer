<Window x:Class="Кудрявцева41размер.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Кудрявцева41размер"
        mc:Ignorable="d"
        Title="OrderWindow" Height="600" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock Text="Дата формирования заказа:"/>
            <DatePicker Name="DateOrder" Width="200" HorizontalAlignment="Left" Margin="0,5,0,10"/>
            <TextBlock Text="Дата доставки заказа:"/>
            <DatePicker Name="DateDelivery" Width="200" HorizontalAlignment="Left" Margin="0,5,0,10"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="10">
            <TextBlock Text="ФИО клиента:"/>
            <TextBlock Name="ClientFIO" FontWeight="Bold" Margin="0,5,0,10"/>
        </StackPanel>

        <ListView Grid.Row="2" Name="OrderListView" Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <Image Width="80" Height="80" Grid.Column="0" Stretch="Uniform">
                            <Image.Source>
                                <Binding Path="Product.ProductPhotoFull">
                                    <Binding.TargetNullValue>
                                        <ImageSource>Resources/picture.png</ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>

                        <StackPanel Grid.Column="1" Margin="10,0">
                            <TextBlock Text="{Binding Product.ProductName}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Product.ProductDescription}" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Product.ProductManufacturer}" FontSize="12"/>
                            <TextBlock Text="{Binding Product.ProductCost, StringFormat={}{0:0} руб.}" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button Content="-" Name="MinusBtn" Click="MinusBtn_Click" Width="30" Height="30" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding ProductCount}" FontSize="20" VerticalAlignment="Center" Margin="5,0"/>
                            <Button Content="+" Name="PlusBtn" Click="PlusBtn_Click" Width="30" Height="30" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Пункт выдачи:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Name="PickupCombo" Width="300" DisplayMemberPath="FullAddress" SelectedValuePath="PickupPointID"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Vertical" HorizontalAlignment="Left" Margin="567,10,0,10" Width="323">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Сумма скидки: "/>
                <TextBlock Name="DiscountSumTB"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock Text="Итоговая сумма: "/>
                <TextBlock Name="TotalSumTB"/>
            </StackPanel>
        </StackPanel>

        <Button Grid.Row="4" Name="SaveBtn" Content="Сохранить" Click="SaveBtn_Click" HorizontalAlignment="Center" Width="200" Height="40" Margin="10"/>
    </Grid>
</Window>
